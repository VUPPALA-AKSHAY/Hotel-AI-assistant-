# Copy to `.env` and fill in your own values. NEVER commit `.env`.

# ── Primary LLM (Mistral, OpenAI-compatible) ────────────────
PRIMARY_API_KEY=your_mistral_api_key
PRIMARY_BASE_URL=https://api.mistral.ai/v1
PRIMARY_MODEL=mistral-medium-3-5

# ── Voice: ElevenLabs TTS ──────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── Voice: Vapi web widget ─────────────────────────────────
VAPI_PRIVATE_API_KEY=your_vapi_private_key
VAPI_PUBLIC_API_KEY=your_vapi_public_key
VAPI_ASSISTANT_ID=your_assistant_id

# ── Server ─────────────────────────────────────────────────
PORT=3000